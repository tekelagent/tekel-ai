# ==============================================================
# Tekel Agent — variables de entorno
#
# SECRETOS: viven en Infisical, no aquí. Se inyectan con
#     infisical run --env=dev -- <comando>
#   Para trabajar sin Infisical, copia este archivo a .env.local
#   y llena los valores (.env.local está en .gitignore).
#
# CONFIGURACIÓN: no son secretos. Tienen defaults en lib/config.ts
#   y se versionan aquí. NO se suben al vault.
# ==============================================================

# ── SECRETOS ──────────────────────────────────────────────────

# Supabase → Project Settings → API. Solo server-side, nunca en el cliente.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter (openrouter.ai → Keys). Una key para todos los modelos.
OPENROUTER_API_KEY=

# Croma (platform.usecroma.com). Si no hay créditos, usa FORENSIC_PROVIDER=mock.
CROMA_API_KEY=

# Socrata: opcional pero recomendado, sube el rate limit gratis.
# Crear en: https://dev.socrata.com/foundry/www.datos.gov.co/jbjy-vk9h → App Tokens
SOCRATA_APP_TOKEN=

# ── CONFIGURACIÓN ─────────────────────────────────────────────

# Capa B (batch masivo, barato).
TEKEL_LLM_BULK_MODEL=deepseek/deepseek-v3.2

# Capa C (razonamiento profundo). Fijado tras el bake-off sobre un pliego real:
# empató con qwen/qwen3.8-max en hallazgos y latencia, y cuesta 5,6 veces menos
# ($0,32/$1,28 por millón contra $2,00/$6,00). Ambos: 1M de contexto y multimodal.
TEKEL_LLM_DEEP_MODEL=qwen/qwen3.7-plus
# Alternativa evaluada, más cara sin ventaja medida en el pliego de prueba:
# TEKEL_LLM_DEEP_MODEL=qwen/qwen3.8-max

# Proveedor forense: croma | mock
# `mock` usa fixtures etiquetadas "datos de muestra".
FORENSIC_PROVIDER=croma
